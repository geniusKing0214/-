# 로컬 예시 (실제 비밀값은 .env에만 두고 커밋하지 마세요)
# SESSION_SECRET_KEY=   (Render 등에서 SECRET_KEY 만 쓰는 경우 그 값으로 대체 가능)
# SECRET_KEY=
# SESSION_COOKIE_SECURE=false
# DB 유지(로컬):
#   환경 변수를 안 쓰면 코드가 <프로젝트 루트>/scheduler.db 한 곳만 사용합니다.
# Docker Compose:
#   DATABASE_URL=sqlite:////data/scheduler.db  이고, 호스트에는 ./data/scheduler.db 로 저장됩니다.
# 클라우드(Render 등):
#   대시보드의 PostgreSQL DATABASE_URL을 쓰면 파일이 아니라 DB 서비스에 영구 저장됩니다.
# DATABASE_URL=sqlite:////data/scheduler.db
#
# Firebase Google 로그인 (Authentication + 웹 앱 설정)
# 서비스 계정 JSON 전체를 한 줄 문자열로 (Render Secret) 또는 파일 경로
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}  (기존 Render 등에서 쓰던 이름)
# FIREBASE_JSON={"type":"service_account",...}
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccount.json
#
# Firebase Console > 프로젝트 설정 > 일반 > 내 앱 > SDK 설정 (웹)
# FIREBASE_WEB_API_KEY=
# FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# FIREBASE_PROJECT_ID=
# FIREBASE_APP_ID=
# FIREBASE_MESSAGING_SENDER_ID=
# FIREBASE_STORAGE_BUCKET=
#
# 관리자 이메일(쉼표 구분). 설정 시 이 주소들만 관리자이며 로그인 시 자동 승인됩니다.
# 목록에 없는 계정은 로그인할 때 관리자 플래그가 해제됩니다.
# ADMIN_EMAILS=owner@gmail.com,other@example.com
#
# ADMIN_EMAILS를 쓰지 않을 때만 아래가 적용됩니다.
# DB에 가입자가 한 명뿐이면 그 계정은 자동 승인+관리자 / 또는 부트스트랩 이메일.
# ADMIN_BOOTSTRAP_EMAILS=you@gmail.com
