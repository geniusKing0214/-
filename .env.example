# 로컬 예시 (실제 비밀값은 .env에만 두고 커밋하지 마세요)
# SESSION_SECRET_KEY=
# SESSION_COOKIE_SECURE=false
# DATABASE_URL=sqlite:///./scheduler.db
#
# Google 로그인 (OAuth 2.0 클라이언트 ID/비밀, Google Cloud Console)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Render 등 리버스 프록시 뒤에서 redirect URI가 http로 잡히면 아래에 공개 HTTPS URL을 넣으세요.
# PUBLIC_BASE_URL=https://your-service.onrender.com
# GOOGLE_REDIRECT_URI=https://your-service.onrender.com/auth/google/callback
