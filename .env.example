# 로컬 예시 (실제 비밀값은 .env에만 두고 커밋하지 마세요)
#
# 터미널에서 실행할 때: 저장소 루트에 이 파일을 복사해 .env 로 두세요.
#   copy .env.example .env   (Windows PowerShell/CMD)
# 앱이 기동되면 python-dotenv 로 위 설정이 자동 로드됩니다. (없으면 Firebase 등 오류)
# SESSION_SECRET_KEY=   (Render 등에서 SECRET_KEY 만 쓰는 경우 그 값으로 대체 가능)
# SECRET_KEY=
#
# 로컬 터미널(uvicorn) — Render .env 에 SESSION_COOKIE_SECURE=true 가 있어도,
# RENDER 등 배포 변수가 없으면 앱이 로컬에서 Secure 쿠키를 자동 비활성화합니다.
# 그래도 필요하면: LOCAL_DEV=1 또는 SESSION_COOKIE_SECURE=false
# 로컬에서 HTTPS 프록시로 Secure 쿠키 테스트: SESSION_COOKIE_SECURE=true 와 FORCE_SECURE_SESSION=1 함께
#
# 로컬 http://127.0.0.1:8000 — Render용 .env 를 그대로 쓰면 SESSION_COOKIE_SECURE=true 가
# 남아 있을 수 있어요. 그러면 로그인 쿠키가 안 붙어 “로그인이 안 됨”처럼 보입니다.
# SESSION_COOKIE_SECURE=false
# SESSION_COOKIE_SECURE=
# DB 유지(로컬) — "한 파일"로 고정(업데이트·git pull 과 무관하게 둘 경로):
#   DATABASE_URL 을 안 쓰고 아래만 써도 됩니다. 예: 내 문서 폴더 (절대 경로)
# HAN_SQLITE_FILE=C:\Users\내이름\Documents\han-scheduler.db
# (별칭) SCHEDULER_SQLITE_FILE=...
#
# DB 유지(로컬) — 기본:
#   위를 비우면 <프로젝트 루트>/data/scheduler.db (Docker Compose ./data 와 동일).
# Docker Compose:
#   DATABASE_URL=sqlite:////data/scheduler.db  이고, 호스트에는 ./data/scheduler.db 로 저장됩니다.
# 클라우드(Render 등):
#   대시보드의 PostgreSQL DATABASE_URL을 쓰면 재배포 후에도 데이터가 유지됩니다(권장).
#   Render에서 Postgres 없이 SQLite만 쓰면 앱이 기동을 거부할 수 있습니다. 그때만(비권장):
# RENDER_ALLOW_SQLITE=1
# DATABASE_URL=sqlite:////data/scheduler.db
#
# SQLite 자동 백업(기본 켜짐): DB 파일과 같은 폴더의 backups/scheduler-날짜.db
# SCHEDULER_SQLITE_BACKUP=1
# SCHEDULER_SQLITE_BACKUP_INTERVAL_SECONDS=21600
# SCHEDULER_SQLITE_BACKUP_KEEP=40
# SCHEDULER_SQLITE_BACKUP_AT_EXIT=1
#
# Docker/Fly/Render 에서 SQLite가 /data 가 아니면 기동 실패(유실 방지). 로컬 테스트만:
# ALLOW_EPHEMERAL_SQLITE=1
#
# ---- Firebase Google 로그인 (없으면 로그인 화면에 “웹 설정 필요” 안내) ----
# 1) Firebase Console (https://console.firebase.google.com) → 프로젝트 선택
# 2) Authentication → Sign-in method → Google 사용 설정
# 3) Authentication → 설정 → 승인된 도메인: 배포 도메인 + localhost + 127.0.0.1
# 4) 프로젝트 설정(톱니) → 일반 → 내 앱 → 웹 앱이 없으면 추가 → SDK 스니펫에서:
#    apiKey → FIREBASE_WEB_API_KEY, authDomain → FIREBASE_AUTH_DOMAIN, projectId → FIREBASE_PROJECT_ID
# 5) 프로젝트 설정 → 서비스 계정 → “새 비공개 키 생성” JSON 다운로드
#    - 로컬: GOOGLE_APPLICATION_CREDENTIALS=C:\경로\파일.json
#    - Render: JSON 파일 내용 전체를 한 줄로 FIREBASE_CREDENTIALS_JSON=... (또는 Secret으로 등록)
#
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# FIREBASE_JSON={"type":"service_account",...}
# GOOGLE_APPLICATION_CREDENTIALS=
#
# FIREBASE_WEB_API_KEY=
# FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_APP_ID=
# FIREBASE_MESSAGING_SENDER_ID=
# FIREBASE_STORAGE_BUCKET=
#
# 관리자 이메일(쉼표 구분). 설정 시 이 주소들만 관리자이며 로그인 시 자동 승인됩니다.
# 목록에 없는 계정은 로그인할 때 관리자 플래그가 해제됩니다.
# ADMIN_EMAILS=owner@gmail.com,other@example.com
#
# ADMIN_EMAILS를 쓰지 않을 때만 아래가 적용됩니다.
# DB에 가입자가 한 명뿐이면 그 계정은 자동 승인+관리자 / 또는 부트스트랩 이메일.
# ADMIN_BOOTSTRAP_EMAILS=you@gmail.com
